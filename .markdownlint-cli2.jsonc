{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": [
        "img",
        "p",
        "div",
        "span"
      ]
    }
  },
  "ignores": [
    "node_modules",
    ".git",
    ".pi",
    "app/build",
    "build"
  ]
}
